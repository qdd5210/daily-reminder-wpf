<Window x:Class="DailyReminder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="每日待办 · 1.4"
        Icon="assets/app-icon.ico"
        Width="380"
        Height="220"
        MinWidth="260"
        MinHeight="130"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource AppFont}"
        Foreground="#F4F8FF"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        SourceInitialized="Window_SourceInitialized"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F8FF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#93A3B8"/>
        <SolidColorBrush x:Key="DimBrush" Color="#65758C"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7DD3FC"/>
        <SolidColorBrush x:Key="AccentBrightBrush" Color="#D6F3FF"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#A9E5FD"/>
        <SolidColorBrush x:Key="AccentGlowBrush" Color="#307DD3FC"/>
        <SolidColorBrush x:Key="AccentHoverGlowBrush" Color="#5A7DD3FC"/>
        <SolidColorBrush x:Key="AccentBorderBrush" Color="#377DD3FC"/>
        <SolidColorBrush x:Key="AccentDimBrush" Color="#4B7DD3FC"/>
        <SolidColorBrush x:Key="AccentRingBrush" Color="#317DD3FC"/>
        <SolidColorBrush x:Key="AccentForegroundBrush" Color="#09202B"/>
        <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#334F718C"/>
        <SolidColorBrush x:Key="SelectionBrush" Color="#747DD3FC"/>
        <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#F7101928"/>
        <SolidColorBrush x:Key="PopupBorderBrush" Color="#38FFFFFF"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FDA4AF"/>

        <Style x:Key="PopupSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#B2000000"
                                      BlurRadius="26"
                                      ShadowDepth="7"
                                      Opacity="0.8"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Surface"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CheckMark"
                                           Text="✓"
                                           Visibility="Collapsed"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#20FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="PanelContextMenu"
                     Style="{StaticResource GlassContextMenu}"
                     Opened="PanelContextMenu_Opened">
            <MenuItem Header="窗口始终置顶"
                      Tag="topmost"
                      IsCheckable="True"
                      Style="{StaticResource GlassMenuItem}"
                      Click="MenuTopmost_Click"/>
            <MenuItem Header="开机自启"
                      Tag="autostart"
                      IsCheckable="True"
                      Style="{StaticResource GlassMenuItem}"
                      Click="MenuAutostart_Click"/>
            <MenuItem Header="设置与样式…"
                      Style="{StaticResource GlassMenuItem}"
                      Click="OpenSettings_Click"/>
        </ContextMenu>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                CornerRadius="10"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#31FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GlassTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#53070D16"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Surface"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#35FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Surface" Property="Background" Value="#66070D16"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InlineTextBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DraftRowSurface" TargetType="Border">
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#24FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmallActionButton" TargetType="Button">
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                CornerRadius="8"
                                Background="#16FFFFFF"
                                BorderBrush="{DynamicResource AccentBorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#10FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="66"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface"
                                CornerRadius="9"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#16FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SegmentSelectedBrush}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircleAddButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="FontSize" Value="27"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Glow" Fill="{DynamicResource AccentGlowBrush}" Margin="-6"/>
                            <Ellipse x:Name="Circle" Fill="{DynamicResource AccentBrush}"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0,-3,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource AccentBrightBrush}"/>
                                <Setter TargetName="Glow" Property="Fill" Value="{DynamicResource AccentHoverGlowBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource AccentPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskDeleteButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="#67788F"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="9" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0,-2,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#25FDA4AF"/>
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwitchCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Track"
                                    Width="38"
                                    Height="22"
                                    CornerRadius="11"
                                    Background="#2A4055">
                                <Ellipse x:Name="Knob"
                                         Width="16"
                                         Height="16"
                                         Fill="#8392A6"
                                         HorizontalAlignment="Left"
                                         Margin="3,0,0,0"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0"
                                              VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#354D63"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#34657C"/>
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                                <Setter Property="Foreground" Value="#C7EAF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="22" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResizeThumb" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TaskTemplate">
            <Border x:Name="TaskRowBorder"
                    MinHeight="30"
                    Margin="1,0"
                    Padding="0,2"
                    Background="Transparent"
                    BorderBrush="#26FFFFFF"
                    BorderThickness="0,0,0,1"
                    ToolTip="{Binding Meta}"
                    PreviewMouseLeftButtonDown="TaskRow_PreviewMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>

                    <Button Tag="{Binding Id}"
                            Width="18" Height="22" Margin="0"
                            ToolTip="完成 / 取消完成"
                            Style="{StaticResource IconButton}"
                            Click="CompleteTask_Click">
                        <Grid Width="12" Height="12">
                            <Ellipse x:Name="TaskDot" Stroke="#8B9AAE" StrokeThickness="1"/>
                            <TextBlock x:Name="TaskCheck" Text="✓" FontSize="10"
                                       Visibility="Collapsed" Foreground="#09202B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <TextBox x:Name="TaskTitle" Grid.Column="1"
                             Text="{Binding Title, Mode=OneWay}"
                             Style="{StaticResource InlineTextBox}"
                             FontSize="13" VerticalAlignment="Center"
                             KeyDown="RowTitle_KeyDown"
                             LostKeyboardFocus="RowTitle_LostKeyboardFocus"/>

                    <TextBlock x:Name="TaskTime"
                               Grid.Column="2"
                               Margin="5,0,3,0"
                               Text="{Binding Time}"
                               VerticalAlignment="Center"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="10"
                               Foreground="{DynamicResource AccentBrush}"/>

                        <Button x:Name="RowAlarmButton" Grid.Column="3" Tag="{Binding Id}"
                                Margin="0"
                                Width="24"
                                Height="24"
                                ToolTip="修改这一行的提醒"
                                Style="{StaticResource IconButton}"
                                Click="RowAlarm_Click">
                            <Viewbox Width="15" Height="15">
                                <Grid Width="20" Height="20">
                                    <Ellipse Width="14"
                                             Height="14"
                                             Stroke="#B6C5D7"
                                             StrokeThickness="1.5"/>
                                    <Line X1="10" Y1="4.6" X2="10" Y2="9.6"
                                          Stroke="#B6C5D7" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="10" Y1="9.6" X2="13.2" Y2="11.6"
                                          Stroke="#B6C5D7" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="4.2" Y1="3.1" X2="1.7" Y2="1"
                                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3"
                                          StrokeStartLineCap="Round"/>
                                    <Line X1="15.8" Y1="3.1" X2="18.3" Y2="1"
                                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3"
                                          StrokeStartLineCap="Round"/>
                                </Grid>
                            </Viewbox>
                        </Button>
                        <Button Grid.Column="4" Tag="{Binding Id}"
                                Width="20"
                                Height="22"
                                Content="×"
                                ToolTip="删除"
                                Style="{StaticResource TaskDeleteButton}"
                                Click="DeleteTask_Click"/>
                    <TextBlock x:Name="ReminderEmphasis" Grid.ColumnSpan="5"
                               Text="‼" FontSize="25" FontWeight="Black"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="0,-9,0,0" Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="TaskDot" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                    <Setter TargetName="TaskDot" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                    <Setter TargetName="TaskCheck" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="TaskTitle" Property="Foreground" Value="#77879B"/>
                    <Setter TargetName="TaskTitle" Property="Opacity" Value="0.6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasReminder}" Value="False">
                    <Setter TargetName="TaskTime" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="RowAlarmButton" Property="Opacity" Value="0.55"/>
                </DataTrigger>
                <Trigger SourceName="TaskRowBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="TaskRowBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="WindowRoot">
        <Border x:Name="GlassShell"
                CornerRadius="14"
                Background="#D9131E30"
                BorderBrush="#38FFFFFF"
                BorderThickness="1"
                ContextMenu="{StaticResource PanelContextMenu}"/>

        <Border x:Name="BackgroundImageLayer" CornerRadius="14"
                IsHitTestVisible="False" Visibility="Collapsed"/>

        <Border x:Name="ShellGlow" CornerRadius="14" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#387DD3FC" Offset="0"/>
                    <GradientStop Color="#10FFFFFF" Offset="0.35"/>
                    <GradientStop Color="#0CC4B5FD" Offset="0.72"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Border Height="128"
                VerticalAlignment="Top"
                CornerRadius="24,24,0,0"
                IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#20FFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid x:Name="MainContent" Margin="14,10,14,10"
              ContextMenu="{StaticResource PanelContextMenu}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="Transparent"
                  Cursor="SizeAll"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="今日待办"
                           FontSize="15"
                           FontWeight="Bold"
                           VerticalAlignment="Top"/>
                <TextBlock x:Name="DateText"
                           Margin="0,21,0,0"
                           FontSize="9"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Top"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-2,0,0">
                    <Button x:Name="SettingsButton"
                            Width="24" Height="24" Margin="0"
                            ToolTip="设置与样式（右键也可以）"
                            Style="{StaticResource IconButton}"
                            Click="SettingsButton_Click">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"/>
                    </Button>
                    <Button Content="−"
                            Width="24" Height="24" Margin="0"
                            ToolTip="收起"
                            Style="{StaticResource IconButton}"
                            Click="Minimize_Click"/>
                    <Button Content="✕"
                            Width="24" Height="24" Margin="0"
                            ToolTip="关闭"
                            Style="{StaticResource CloseButton}"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,3,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="TaskCountText"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontSize="9"
                               Foreground="{StaticResource DimBrush}"/>
                    <Button x:Name="AddRowButton"
                            Visibility="Collapsed"
                            Width="20"
                            Height="20"
                            Margin="0"
                            Content="＋"
                            ToolTip="添加一行"
                            FontSize="16"
                            Style="{StaticResource IconButton}"
                            Click="AddRow_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,3,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="TaskScroll"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                        <ItemsControl x:Name="TaskItems"
                                      ItemTemplate="{StaticResource TaskTemplate}"
                                      Focusable="False"/>
                </ScrollViewer>

                        <Border x:Name="DraftRow"
                                Grid.Row="1"
                                Height="26"
                                Margin="1,0"
                                Padding="0"
                                Style="{StaticResource DraftRowSurface}"
                                Visibility="Visible">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="22"/>
                                </Grid.ColumnDefinitions>

                                <Grid>
                                    <TextBox x:Name="TitleTextBox"
                                              Height="24"
                                             Padding="2,0"
                                             FontSize="12.5"
                                             Style="{StaticResource InlineTextBox}"
                                             TextChanged="TitleTextBox_TextChanged"
                                             KeyDown="DraftTitle_KeyDown"/>
                                    <TextBlock x:Name="TitlePlaceholder"
                                               Margin="3,0,8,0"
                                               Text="写一条待办，回车添加"
                                               FontSize="11.5"
                                               Foreground="#66778D"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               IsHitTestVisible="False"/>
                                </Grid>

                                <Button x:Name="AlarmButton"
                                        Grid.Column="1"
                                        Width="24"
                                        Height="24"
                                        Margin="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        ToolTip="设置这一行的提醒"
                                        Style="{StaticResource IconButton}"
                                        Click="DraftAlarm_Click">
                                    <Viewbox Width="15" Height="15">
                                        <Grid Width="20" Height="20">
                                            <Ellipse Width="14"
                                                     Height="14"
                                                     Stroke="#B6C5D7"
                                                     StrokeThickness="1.5"/>
                                            <Line X1="10" Y1="4.6" X2="10" Y2="9.6"
                                                  Stroke="#B6C5D7" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Line X1="10" Y1="9.6" X2="13.2" Y2="11.6"
                                                  Stroke="#B6C5D7" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Line X1="4.2" Y1="3.1" X2="1.7" Y2="1"
                                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3"
                                                  StrokeStartLineCap="Round"/>
                                            <Line X1="15.8" Y1="3.1" X2="18.3" Y2="1"
                                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3"
                                                  StrokeStartLineCap="Round"/>
                                        </Grid>
                                    </Viewbox>
                                </Button>

                                <Button Grid.Column="2"
                                        Width="20"
                                        Height="20"
                                        Content="＋"
                                        ToolTip="添加这一行"
                                        Style="{StaticResource TaskDeleteButton}"
                                        Click="AddDraft_Click"/>
                            </Grid>
                        </Border>

                <StackPanel x:Name="EmptyState"
                            Visibility="Collapsed"
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <Ellipse Width="10"
                             Height="10"
                             Fill="{DynamicResource AccentDimBrush}"/>
                    <TextBlock Margin="0,14,0,0"
                               Text="今天还没有安排"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#8292A7"
                               HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,6,0,0"
                               Text="点击右上角 ＋ 添加一行"
                               FontSize="11"
                               Foreground="#526278"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" Margin="2,10,2,0">
                <TextBlock x:Name="PanelHintText"
                            Text="右键设置"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="{StaticResource DimBrush}"/>
                <TextBlock x:Name="StatusText"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="{StaticResource DimBrush}"/>
            </Grid>
        </Grid>

        <Popup x:Name="AlarmPopup"
               PlacementTarget="{Binding ElementName=AlarmButton}"
               Placement="Bottom"
               HorizontalOffset="-234"
               VerticalOffset="9"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Closed="AlarmPopup_Closed">
            <Grid Margin="12">
                <Border Width="282" Style="{StaticResource PopupSurface}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="提醒（可选）"
                                       FontSize="14"
                                       FontWeight="Bold"/>
                            <TextBlock Text="点击面板外收起"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="9.5"
                                       Foreground="{StaticResource DimBrush}"/>
                        </Grid>

                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="时间"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <TextBox x:Name="TimeTextBox"
                                     Grid.Column="1"
                                     Width="98"
                                     Height="38"
                                     TextAlignment="Center"
                                     FontFamily="Cascadia Mono, Consolas"
                                       ToolTip="HH:mm；留空则不提醒"
                                     Style="{StaticResource InlineTextBox}"
                                     TextChanged="AlarmField_TextChanged"
                                     KeyDown="AlarmInput_KeyDown"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="重复"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <Border Grid.Column="1"
                                    Padding="2"
                                    CornerRadius="11"
                                    Background="#26070D16"
                                    BorderBrush="#18FFFFFF"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="DailyRadio"
                                                 Grid.Column="0"
                                                 Content="每天"
                                                 GroupName="Repeat"
                                                 IsChecked="True"
                                                 Style="{StaticResource SegmentRadio}"
                                                 Checked="Repeat_Checked"/>
                                    <RadioButton x:Name="OnceRadio"
                                                 Grid.Column="1"
                                                 Content="仅一次"
                                                 GroupName="Repeat"
                                                 Style="{StaticResource SegmentRadio}"
                                                 Checked="Repeat_Checked"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid x:Name="DateSettingRow"
                              Margin="0,12,0,0"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="日期"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <TextBox x:Name="DateTextBox"
                                     Grid.Column="1"
                                     Width="128"
                                     Height="38"
                                     TextAlignment="Center"
                                     FontFamily="Cascadia Mono, Consolas"
                                     ToolTip="仅一次任务的日期"
                                     Style="{StaticResource InlineTextBox}"
                                     TextChanged="AlarmField_TextChanged"
                                     KeyDown="AlarmInput_KeyDown"/>
                        </Grid>

                        <TextBlock x:Name="AlarmErrorText"
                                   Margin="0,9,0,0"
                                   FontSize="9.5"
                                   Foreground="{StaticResource DangerBrush}"
                                   Visibility="Collapsed"/>

                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="不提醒"
                                    Width="52"
                                    Height="26"
                                    FontSize="10"
                                    Foreground="{StaticResource MutedBrush}"
                                    Style="{StaticResource IconButton}"
                                    Click="ClearAlarm_Click"/>
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,8,0"
                                       Text="Enter 保存"
                                       VerticalAlignment="Center"
                                       FontSize="9.5"
                                       Foreground="#56677E"/>
                            <Button Grid.Column="2"
                                    Content="保存"
                                    Style="{StaticResource SmallActionButton}"
                                    Click="SaveAlarm_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>

        <Popup x:Name="SettingsPopup"
               PlacementTarget="{Binding ElementName=SettingsButton}"
               Placement="Bottom"
               HorizontalOffset="-258"
               VerticalOffset="9"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Closed="SettingsPopup_Closed">
            <Grid Margin="12">
                <Border Width="306" Style="{StaticResource PopupSurface}">
                    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="面板设置"
                                       FontSize="14"
                                       FontWeight="Bold"/>
                            <TextBlock Text="右键也可打开"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="9.5"
                                       Foreground="{StaticResource DimBrush}"/>
                        </Grid>

                        <TextBlock Margin="0,17,0,8"
                                   Text="样式"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <Border Padding="2"
                                CornerRadius="11"
                                Background="#26070D16"
                                BorderBrush="#18FFFFFF"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="NightThemeRadio"
                                             Grid.Column="0"
                                             Content="夜蓝"
                                             Tag="night"
                                             GroupName="Theme"
                                             IsChecked="True"
                                             Style="{StaticResource SegmentRadio}"
                                             Checked="ThemeRadio_Checked"/>
                                <RadioButton x:Name="TealThemeRadio"
                                             Grid.Column="1"
                                             Content="青雾"
                                             Tag="teal"
                                             GroupName="Theme"
                                             Style="{StaticResource SegmentRadio}"
                                             Checked="ThemeRadio_Checked"/>
                                <RadioButton x:Name="AmberThemeRadio"
                                             Grid.Column="2"
                                             Content="暖铜"
                                             Tag="amber"
                                             GroupName="Theme"
                                             Style="{StaticResource SegmentRadio}"
                                             Checked="ThemeRadio_Checked"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="自定义背景" Margin="0,14,0,6" FontSize="10"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BackgroundNameText" Text="玻璃背景"
                                       VerticalAlignment="Center" FontSize="10"
                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource DimBrush}"/>
                            <Button Grid.Column="1" Content="选图片" Margin="5,0"
                                    Style="{StaticResource SmallActionButton}" Click="ChooseBackground_Click"/>
                            <Button Grid.Column="2" Content="清除"
                                    Style="{StaticResource SmallActionButton}" Click="ClearBackground_Click"/>
                        </Grid>
                        <Slider x:Name="BackgroundOpacitySlider" Margin="0,5,0,0"
                                Minimum="10" Maximum="100" Value="65"
                                ToolTip="背景图片强度"
                                ValueChanged="BackgroundOpacitySlider_ValueChanged"/>

                        <TextBlock Text="提醒动画" Margin="0,12,0,6" FontSize="10"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <UniformGrid Columns="2" Rows="2">
                            <RadioButton x:Name="BounceStyleRadio" Content="弹跳" Tag="bounce"
                                         GroupName="ReminderStyle" Style="{StaticResource SegmentRadio}"
                                         Checked="ReminderStyle_Checked"/>
                            <RadioButton x:Name="JellyStyleRadio" Content="果冻" Tag="jelly"
                                         GroupName="ReminderStyle" Style="{StaticResource SegmentRadio}"
                                         Checked="ReminderStyle_Checked"/>
                            <RadioButton x:Name="SurpriseStyleRadio" Content="惊叹！" Tag="surprise"
                                         GroupName="ReminderStyle" Style="{StaticResource SegmentRadio}"
                                         Checked="ReminderStyle_Checked"/>
                            <RadioButton x:Name="BreatheStyleRadio" Content="呼吸" Tag="breathe"
                                         GroupName="ReminderStyle" Style="{StaticResource SegmentRadio}"
                                         Checked="ReminderStyle_Checked"/>
                        </UniformGrid>
                        <Button Content="预览提醒 · F6" HorizontalAlignment="Right" Margin="0,7,0,0"
                                Style="{StaticResource SmallActionButton}" Click="PreviewReminder_Click"/>

                        <Grid Margin="0,15,0,0">
                            <TextBlock Text="玻璃透明度"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="OpacityValueText"
                                       HorizontalAlignment="Right"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="10"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Grid>
                        <Slider x:Name="OpacitySlider"
                                Margin="0,5,0,0"
                                Minimum="55"
                                Maximum="96"
                                Value="88"
                                SmallChange="1"
                                LargeChange="5"
                                ValueChanged="OpacitySlider_ValueChanged"/>

                        <Border Height="1"
                                Margin="0,15,0,13"
                                Background="#1DFFFFFF"/>

                        <CheckBox x:Name="TopmostCheckBox"
                                  Content="窗口始终置顶"
                                  Style="{StaticResource SwitchCheckBox}"
                                  Checked="TopmostCheckBox_Changed"
                                  Unchecked="TopmostCheckBox_Changed"/>
                        <CheckBox x:Name="AutostartCheckBox"
                                  Margin="0,12,0,0"
                                  Content="开机自启"
                                  Style="{StaticResource SwitchCheckBox}"
                                  Checked="AutostartCheckBox_Changed"
                                  Unchecked="AutostartCheckBox_Changed"/>
                        <TextBlock Margin="47,7,0,0"
                                   Text="开机后在右上角安静启动"
                                   FontSize="9.5"
                                   Foreground="#56677E"/>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Popup>

        <Grid x:Name="CompactContent" Visibility="Collapsed">
            <Button Style="{StaticResource CompactButton}"
                    Click="RestoreCompact_Click">
                <Grid Margin="18,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="22" Height="22" VerticalAlignment="Center">
                        <Ellipse Width="20"
                                 Height="20"
                                 Stroke="{DynamicResource AccentRingBrush}"
                                 StrokeThickness="1"/>
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{DynamicResource AccentBrush}"/>
                    </Grid>
                    <StackPanel Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="每日待办"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="CompactPendingText"
                                   Margin="0,2,0,0"
                                   FontSize="9.5"
                                   Foreground="{StaticResource DimBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="›"
                               FontSize="22"
                               Foreground="#718299"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </Grid>

        <Canvas Width="14"
                Height="14"
                Margin="0,0,11,10"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False">
            <Line X1="3" Y1="12" X2="12" Y2="3"
                  Stroke="#6E8199" StrokeThickness="1"/>
            <Line X1="7" Y1="12" X2="12" Y2="7"
                  Stroke="#6E8199" StrokeThickness="1"/>
            <Line X1="10" Y1="12" X2="12" Y2="10"
                  Stroke="#6E8199" StrokeThickness="1"/>
        </Canvas>

        <Thumb x:Name="ResizeLeft"
               Width="8"
               HorizontalAlignment="Left"
               VerticalAlignment="Stretch"
               Cursor="SizeWE"
               Style="{StaticResource ResizeThumb}"
               DragDelta="ResizeLeft_DragDelta"
               DragCompleted="Resize_DragCompleted"/>
        <Thumb x:Name="ResizeRight"
               Width="8"
               HorizontalAlignment="Right"
               VerticalAlignment="Stretch"
               Cursor="SizeWE"
               Style="{StaticResource ResizeThumb}"
               DragDelta="ResizeRight_DragDelta"
               DragCompleted="Resize_DragCompleted"/>
        <Thumb x:Name="ResizeTop"
               Height="8"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Top"
               Cursor="SizeNS"
               Style="{StaticResource ResizeThumb}"
               DragDelta="ResizeTop_DragDelta"
               DragCompleted="Resize_DragCompleted"/>
        <Thumb x:Name="ResizeBottom"
               Height="8"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Bottom"
               Cursor="SizeNS"
               Style="{StaticResource ResizeThumb}"
               DragDelta="ResizeBottom_DragDelta"
               DragCompleted="Resize_DragCompleted"/>
        <Thumb x:Name="ResizeTopLeft"
               Width="16"
               Height="16"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Cursor="SizeNWSE"
               Style="{StaticResource ResizeThumb}"
               DragDelta="ResizeTopLeft_DragDelta"
               DragCompleted="Resize_DragCompleted"/>
        <Thumb x:Name="ResizeTopRight"
               Width="16"
               Height="16"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Cursor="SizeNESW"
               Style="{StaticResource ResizeThumb}"
               DragDelta="ResizeTopRight_DragDelta"
               DragCompleted="Resize_DragCompleted"/>
        <Thumb x:Name="ResizeBottomLeft"
               Width="16"
               Height="16"
               HorizontalAlignment="Left"
               VerticalAlignment="Bottom"
               Cursor="SizeNESW"
               Style="{StaticResource ResizeThumb}"
               DragDelta="ResizeBottomLeft_DragDelta"
               DragCompleted="Resize_DragCompleted"/>
        <Thumb x:Name="ResizeBottomRight"
               Width="16"
               Height="16"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Cursor="SizeNWSE"
               Style="{StaticResource ResizeThumb}"
               DragDelta="ResizeBottomRight_DragDelta"
               DragCompleted="Resize_DragCompleted"/>
    </Grid>
</Window>
